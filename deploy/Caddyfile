{$GALLERY_ADDRESS::80} {
	encode gzip zstd
	root * "{$GALLERY_FRONTEND:../frontend/dist}"

	request_body {
		max_size 20MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file "{$GALLERY_ACCESS_LOG:../server/logs/caddy-access.log}" {
			roll_size 10MB
			roll_keep 5
		}
	}
}
