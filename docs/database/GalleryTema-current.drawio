        <mxCell id="note-0" value="subscription_history.event_type = purchase | renewal | cancellation | expiration | plan_change" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
