          <mxGeometry x="454" y="0" width="50" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-heading" value="ОБОЗНАЧЕНИЯ И ВАЖНЫЕ ДЕТАЛИ" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#172B3A;fontStyle=1;fillColor=#EAF0F5;">
          <mxGeometry x="76" y="1158" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="telegram_moderation_deliveries.entity_id: kind=art → arts.id; kind=author → author_profiles.user_id. Это REF, не SQL FK." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1191" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="telegram_accounts.pending_delivery_id — REF без FK. UQ доставок: (user_id, kind, entity_id, revision)." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1219" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="content_translations — кеш по ключу; прямой FK к переводимым сущностям отсутствует. _schema_migrations создаётся механизмом миграций." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1247" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="Имена полей и регистр сохранены. createdAt / updatedAt показаны вместе с created_at / updated_at, когда модель создаёт оба набора." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1275" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="Схема сверена с моделями и миграциями репозитория; фактическая структура БД опубликованного сервера не запрашивалась." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1303" width="1752" height="28" as="geometry" />
        </mxCell>
