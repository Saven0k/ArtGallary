          <mxGeometry x="76" y="1695" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="SQL*: FK user_id → users.id для notification_settings / push_subscriptions описан в CREATE TABLE IF NOT EXISTS миграции." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1723" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="При создании этих таблиц через ORM до миграции FK может отсутствовать. Это не подтверждённое ограничение работающей БД." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1751" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-7" value="notifications.target_id, metadata и subscription_history.metadata — данные приложения; отдельные FK для их содержимого не объявлены." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1779" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-8" value="Имена полей и регистр сохранены. createdAt / updatedAt показаны вместе с created_at / updated_at, когда модель создаёт оба набора." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1807" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-9" value="Схема сверена с моделями и миграциями репозитория; фактическая структура БД опубликованного сервера не запрашивалась." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1835" width="1752" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
