          <mxGeometry x="76" y="1611" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="subscription_history.payment_status = success | failed | pending" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="1639" width="1752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="notifications.type = art_like | author_like | new_follower | new_art" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
