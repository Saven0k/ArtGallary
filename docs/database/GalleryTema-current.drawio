        <mxCell id="note-heading" value="ОБОЗНАЧЕНИЯ И ВАЖНЫЕ ДЕТАЛИ" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#172B3A;fontStyle=1;fillColor=#EAF0F5;">
          <mxGeometry x="76" y="2110" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="Обзор показывает все 35 таблиц и их ключи. Все 277 полей раскрыты на страницах 02–06." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2143" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="34 модели приложения + журнал _schema_migrations. Схема построена по коду 2814251 от 20.10.2026." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2171" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="FK — ограничение из ORM. REF / JSON — связь приложения без SQL FK. SQL* — условие из SQL-миграции." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2199" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="SQL*: CREATE TABLE IF NOT EXISTS не добавляет FK к уже существующим notification_settings / push_subscriptions." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2227" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="arts.author_id → author_profiles.user_id. В author_profiles нет отдельного id; art_tags имеет составной PK." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2255" width="4328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="events, content_translations, telegram_bot_state и _schema_migrations не имеют внешних ключей." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#627487;fontStyle=0;">
          <mxGeometry x="76" y="2283" width="4328" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
