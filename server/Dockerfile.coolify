FROM node:22-alpine AS build
WORKDIR /app
COPY server/package*.json ./
RUN npm ci
COPY server/ ./
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY deploy/sql ./migrations
COPY server/docker-entrypoint.sh ./docker-entrypoint.sh
RUN mkdir -p /data/uploads /app/logs && chmod 755 ./docker-entrypoint.sh
ENV STATIC_DIR=/data/uploads HTTP_HOST=0.0.0.0 PORT=5000 DB_SYNC=false
EXPOSE 5000
ENTRYPOINT ["/bin/sh", "/app/docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]