# ──────────────────────────────────────────────────────────────────────────────
# Пример переменных окружения сервера.
#   dev : скопируйте в .development.env   (npm run start:dev)
#   prod: скопируйте в .production.env    (npm run start:prod / pm2)
# Файлы .development.env / .production.env / .env в git не попадают.
# Переменные, заданные в окружении процесса (pm2, docker), имеют приоритет над файлом.
# ──────────────────────────────────────────────────────────────────────────────

# Порт HTTP-сервера Nest (за reverse proxy наружу не открывается)
PORT=5000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gallery

# Синхронизация схемы Sequelize при старте:
#   alter  — CREATE + ALTER TABLE под модели (по умолчанию; пока нет миграций)
#   create — только CREATE TABLE IF NOT EXISTS
#   false  — схему не трогать
DB_SYNC=alter

# JWT — в production сгенерируйте два РАЗНЫХ длинных секрета:
#   PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
#   bash:       openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# Публичный адрес, с которого браузер скачивает загруженные файлы (/static/...).
# Сохраняется в БД в URL картинок, поэтому должен быть именно внешним адресом.
#   dev (фронт ходит напрямую на Nest):        http://localhost:5000
#   prod за Caddy/nginx с префиксом /api:      http://<ваш-статический-ip>/api
#   prod с доменом и HTTPS:                    https://gallery.example.com/api
BASE_URL=http://localhost:5000

# Каталог загруженных файлов. По умолчанию src/static.
# В production укажите путь ВНЕ исходников (относительно server/ или абсолютный),
# чтобы обновление кода не трогало загрузки, например: ../data/uploads  или  D:/gallery/uploads
STATIC_DIR=src/static

# CORS. Нужен только когда фронт и API на РАЗНЫХ origin (dev: vite на 5173).
# В production за reverse proxy фронт и API на одном origin — можно оставить как есть.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Доверять заголовкам X-Forwarded-* от reverse proxy (Caddy/nginx/docker): true в production
TRUST_PROXY=false

# Secure-флаг на cookie с токенами. Браузер принимает такие cookie ТОЛЬКО по HTTPS.
# Если production работает по голому http://<ip> — обязательно COOKIE_SECURE=false,
# иначе логин не будет работать. При переходе на HTTPS поставьте true.
# (Не задано → true в production, false в development.)
COOKIE_SECURE=false

# Swagger UI на /api/docs. Не задано → включён везде, кроме production.
SWAGGER_ENABLED=false

# Администратор, создаётся при первом старте, если пользователя с таким email нет
ADMIN_EMAIL=admin@mail.ru
ADMIN_PASSWORD=change_me_Strong1!
ADMIN_NAME=Администратор
ADMIN_SURNAME=Системный
ADMIN_SECOND_NAME=Системович
ADMIN_PHONE=+70000000000

# Почта (коды смены пароля/email). В development письма не отправляются, код пишется в лог.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Art Gallery <no-reply@example.com>"
