# Базовый URL API (попадает в бандл при сборке!)
#   dev : http://localhost:5000   — фронт на vite:5173 ходит напрямую на Nest
#   prod: /api                    — фронт и API на одном origin, Caddy/nginx снимает префикс
# Локальные переопределения кладите в .env.local / .env.production.local (в git не попадают)
VITE_API_URL=http://localhost:5000
